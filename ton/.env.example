# Deployment settings for contracts/ton.
#
# One file per network, so the two can never be confused for each other:
#
#   cp .env.example .env.testnet     # npm run deploy:testnet
#   cp .env.example .env.mainnet     # npm run deploy:mainnet
#
# Both are gitignored. Machine-local overrides go in .env.<network>.local, and
# anything network-agnostic can live in a shared .env, which is read last.
#
# There is no TON_NETWORK setting here: the network is chosen by the npm script
# you run, and that choice is what selects this file. Setting it inside the file
# could only ever disagree with the file's own name.
#
# Generate wallets with:  npx ts-node scripts/wallet.ts new
# It prints the words and the address, labelled with the variables they go into.

# The 24 words of the wallet that pays for the deployment. It becomes the owner
# unless TON_OWNER_ADDRESS is set. Fund it first — on testnet from
# @testgiver_ton_bot on Telegram.
#
# NOT BIP-39: TON has its own mnemonic scheme, and a seed phrase from another
# chain is refused rather than silently deriving a different wallet.
TON_DEPLOYER_MNEMONIC=

# The address allowed to settle disputes. Must be the wallet whose words the
# dispute signer holds — nothing checks this and nothing fails until the first
# dispute. It also needs its own TON: a wallet on TON is a
# contract, and an unfunded one cannot send.
TON_ARBITER_ADDRESS=

# Where platform fees are paid.
TON_FEE_COLLECTOR_ADDRESS=

# Optional. The owner can change the arbiter and sweep surplus, so on mainnet it
# belongs somewhere colder than the deploying key. Defaults to the deployer.
TON_OWNER_ADDRESS=

# Optional. Set once deployed, for scripts/allow-asset.ts.
TON_ESCROW_ADDRESS=

# Strongly recommended. Without it toncenter allows roughly one request a second
# and the scripts spend their time being throttled. Free from @tonapibot.
TONCENTER_API_KEY=

# Optional. Operating balance the escrow keeps for storage rent, in TON.
# Default 0.5. This is never confusable with escrowed funds — the contract
# tracks those separately in lockedNative.
TON_ESCROW_RESERVE=0.5
