{
  "name": "elexa-ton-escrow",
  "version": "1.0.0",
  "private": true,
  "description": "ElexaEscrow for TON — the TON counterpart of contracts/contracts/ElexaEscrow.sol",
  "scripts": {
    "build": "tact --config ./tact.config.json",
    "test": "jest",
    "wallet": "TON_NETWORK=testnet ts-node scripts/wallet.ts",
    "wallet:mainnet": "TON_NETWORK=mainnet ts-node scripts/wallet.ts",
    "deploy:testnet": "TON_NETWORK=testnet ts-node scripts/deploy.ts",
    "deploy:mainnet": "TON_NETWORK=mainnet ts-node scripts/deploy.ts",
    "allow-asset:testnet": "TON_NETWORK=testnet ts-node scripts/allow-asset.ts",
    "allow-asset:mainnet": "TON_NETWORK=mainnet ts-node scripts/allow-asset.ts"
  },
  "devDependencies": {
    "@tact-lang/compiler": "^1.6.13",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/sandbox": "^0.44.0",
    "@ton/test-utils": "^0.12.0",
    "@ton/ton": "^16.3.0",
    "@types/jest": "^30.0.0",
    "dotenv": "^16.6.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
