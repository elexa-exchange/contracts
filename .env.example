# Deployment settings for contracts/ (BSC and TRON).
#
# One file per target, so the two can never be confused for each other:
#
#   cp .env.example .env.testnet     # npm run deploy:testnet, deploy:tron-shasta
#   cp .env.example .env.mainnet     # npm run deploy:mainnet, deploy:tron
#
# Both are gitignored. Machine-local overrides go in .env.<target>.local, and
# anything target-agnostic can live in a shared .env, which is read last.
#
# Which file is used comes from DEPLOY_ENV, which the npm scripts set. Running
# hardhat by hand, it is inferred from --network (bsc / bscTestnet) or
# TRON_NETWORK, defaulting to testnet. See env.ts.
#
# TON is a separate toolchain: contracts/ton, with its own .env.<network>.

# ---------------------------------------------------------------- BSC / EVM
# Deployment
DEPLOYER_PRIVATE_KEY=
OWNER_ADDRESS=
ARBITER_ADDRESS=
FEE_COLLECTOR_ADDRESS=

# Comma-separated BEP-20 addresses the escrow may hold.
# VERIFY ON BSCSCAN BEFORE USING. USDT BEP-20 on mainnet is 18 decimals.
ALLOWED_TOKENS=

# RPC (defaults to public endpoints; use a paid provider in production)
BSC_RPC_URL=
BSC_TESTNET_RPC_URL=

# BscScan verification
ETHERSCAN_API_KEY=

# Set true to also allow escrowing native BNB, not just tokens.
ALLOW_NATIVE=false

# -------------------------------------------------------------------- TRON
# Used only by scripts/deploy-tron.ts, which deploys the *same* contract from
# the same compiled artifact. Addresses here are base58 (T…), not 0x-hex.
#
#   npm run deploy:tron-shasta     (testnet, .env.testnet)
#   npm run deploy:tron            (mainnet, .env.mainnet)

# shasta (default) | mainnet. Set by the npm scripts; the value here only
# matters when running the script by hand.
TRON_NETWORK=shasta
TRON_PRIVATE_KEY=
TRON_OWNER_ADDRESS=
# Must match the address your application signs dispute resolutions with.
# Nothing checks this at deploy time and nothing fails until the first dispute,
# so derive the address from that key and compare it by hand.
TRON_ARBITER_ADDRESS=
TRON_FEE_COLLECTOR=

# Comma-separated TRC-20 addresses the escrow may hold.
# VERIFY ON TRONSCAN BEFORE USING. USDT TRC-20 is 6 decimals, not 18 —
# mainnet TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t, Shasta TG3XXyExBkPp9nzdajDZsozEu4BkaSJozs.
TRON_ALLOWED_TOKENS=

# Set true to also allow escrowing native TRX, not just tokens.
TRON_ALLOW_NATIVE=false

# TronGrid throttles unauthenticated traffic hard; effectively required on mainnet.
TRONGRID_API_KEY=

# ------------------------------------------------------------------ ABI SYNC
# `npm run export-abi` always refreshes abi/ElexaEscrow.json. If an application
# in this checkout embeds the ABI, point these at it to update it in the same
# pass. Paths are relative to this directory; leave blank to skip.
ABI_EXPORT_JSON=
ABI_EXPORT_TS=
